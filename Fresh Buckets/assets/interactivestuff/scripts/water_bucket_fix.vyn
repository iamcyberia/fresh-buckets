check modLoader.isResourcePackLoaded("interactivestuff:interactive_resourcepack") do    excludeScript("interactivestuff:interactive_resourcepack","water_bucket")endtask onItemUpdate takes itemRendered do    check player.getGamemode() != "spectator" do        check itemRendered.getName() == "minecraft:water_bucket" do			itemRendered.setItemModel("minecraft:water_bucket")            check player.isSubmergedInWater() do                itemRendered.setItemModel("minecraft:bucket")            end        end    endend